---
import { CATEGORIES, apps } from '../data/apps';

const catalog = apps.map((app) => ({
  slug: app.slug,
  name: app.name,
  category: app.category,
  tagline: app.tagline,
  description: app.description,
  features: app.features,
  storage: app.storage,
  keywords: app.keywords,
  url: `https://alexmerced.app/${app.slug}`,
}));

const categories = CATEGORIES.map((category) => ({ id: category.id, label: category.label, blurb: category.blurb }));

const agentTools = [
  { slug: 'quarry', url: 'https://alexmerced.app/quarry', tools: [
    'quarry_load_data: load CSV, JSON or NDJSON as a table',
    'quarry_run_sql: run real SQL over it, joins and window functions included',
    'quarry_list_tables: read the schema before writing a query',
    'quarry_export_parquet: get a result back as a Parquet file',
  ] },
  { slug: 'ordinate', url: 'https://alexmerced.app/ordinate', tools: [
    'ordinate_render_chart: turn data into standalone SVG',
    'ordinate_describe_data: see the columns and which chart would suit',
  ] },
  { slug: 'decanter', url: 'https://alexmerced.app/decanter', tools: [
    'decanter_convert: JSON, NDJSON, CSV, YAML and TOML in any direction',
    'decanter_infer_schema: fields, or SQL, Iceberg or JSON Schema',
    'decanter_reshape: flatten, unflatten, or query by path',
  ] },
  { slug: 'tessera', url: 'https://alexmerced.app/tessera', tools: [
    'tessera_generate_qr: a QR code as SVG and PNG, with payloads built for you',
    'tessera_read_qr: read a code out of an image, and say whether it is safe to follow',
    'tessera_decode_matrix: read a code from a grid of modules',
  ] },
  { slug: 'fabler', url: 'https://alexmerced.app/fabler', tools: [
    'fabler_list_field_kinds: what can be generated',
    'fabler_generate: seeded sample data with working foreign keys',
  ] },
  { slug: 'sift', url: 'https://alexmerced.app/sift', tools: [
    'sift_test_regex: run a pattern and see every match and group',
    'sift_replace: apply a replacement',
    'sift_explain_regex: what each piece of a pattern does, in plain English',
  ] },
  { slug: 'reckoner', url: 'https://alexmerced.app/reckoner', tools: [
    'reckoner_evaluate: evaluate an expression with a real parser, not eval',
    'reckoner_evaluate_many: a list of them at once',
  ] },
  { slug: 'tally', url: 'https://alexmerced.app/tally', tools: [
    'tally_compute_totals: invoice arithmetic in whole cents',
    'tally_create_invoice: build one, save it, get a PDF back',
    'tally_list_invoices: what is outstanding',
    'tally_export_invoice: PDF, plain text, or CSV',
  ] },
  { slug: 'warren', url: 'https://alexmerced.app/warren', tools: [
    'warren_list_pages, warren_read_page, warren_search: read the notebook',
    'warren_create_page, warren_append_to_page: write to it, in Markdown',
  ] },
  { slug: 'jotterbug', url: 'https://alexmerced.app/jotterbug', tools: [
    'jotterbug_list_notes, jotterbug_search_notes: read the board',
    'jotterbug_create_note, jotterbug_update_note, jotterbug_delete_note: change it',
  ] },
  { slug: 'laneway', url: 'https://alexmerced.app/laneway', tools: [
    'laneway_get_board: columns, cards, limits, due dates',
    'laneway_add_card, laneway_move_card, laneway_archive_card: change the board',
    'laneway_whats_due: what needs doing, across every board',
  ] },
  { slug: 'stint', url: 'https://alexmerced.app/stint', tools: [
    'stint_current, stint_start_timer, stint_stop_timer: run the clock',
    'stint_log_time: record work already done',
    'stint_summary: where the time went, by project',
  ] },
  { slug: 'rote', url: 'https://alexmerced.app/rote', tools: [
    'rote_list_decks, rote_due_cards, rote_search_cards: read the decks',
    'rote_add_cards: turn an explanation into flashcards',
    'rote_review_card: record an answer and get the next interval',
  ] },
  { slug: 'rostrum', url: 'https://alexmerced.app/rostrum', tools: [
    'rostrum_create_deck: Markdown into a deck, and out as PDF or HTML',
    'rostrum_list_decks, rostrum_read_deck',
  ] },
  { slug: 'loupe', url: 'https://alexmerced.app/loupe', tools: [
    'loupe_read_exif: what a photograph is carrying, including GPS',
    'loupe_plan_resize: what an image would become at a given size',
  ] },
];

const storagePolicy = {
  summary:
    'Every app runs entirely in the visitor’s browser. Records go in IndexedDB, interface preferences in localStorage. Nothing is uploaded, there is no account, and there is no analytics or third-party code.',
  consequences: [
    'Data is scoped to one browser on one device and does not sync.',
    'Private windows usually discard everything on close.',
    'Clearing site data deletes it, and it cannot be recovered by anyone.',
    'Nobody, the author included, can see what a visitor writes.',
  ],
  portability:
    'Every app exports its whole dataset as JSON using one shared envelope, and imports it back with a merge or replace choice. Merging keeps whichever copy was edited most recently.',
  offline: 'The site installs as a progressive web app and works with no network at all after the first visit.',
};
---

<script is:inline define:vars={{ catalog, categories, storagePolicy, agentTools }}>
  (function () {
    // The proposal has moved between navigator and document; accept either.
    const ctx = navigator.modelContext || document.modelContext;
    if (!ctx || typeof ctx.registerTool !== 'function') return;

    const ok = (value) => ({ content: [{ type: 'text', text: JSON.stringify(value, null, 2) }] });

    const tools = [
      {
        name: 'list_apps',
        description:
          'List every tool on alexmerced.app, with what it does, its features, where it stores data, and its URL. Categories are: write (notes), plan (tasks and time), data (format and generation tools), make (files: images, PDFs, decks, QR codes), and count (calculator and regex).',
        inputSchema: {
          type: 'object',
          properties: {
            category: {
              type: 'string',
              enum: categories.map((entry) => entry.id),
              description: 'Optional category filter. Omit to list everything.',
            },
          },
        },
        execute: async ({ category } = {}) =>
          ok({
            categories,
            apps: category ? catalog.filter((app) => app.category === category) : catalog,
          }),
      },
      {
        name: 'search_apps',
        description:
          'Find the tool on alexmerced.app that does a particular job. Searches names, taglines, descriptions, features and keywords. Try terms like "resize an image", "merge PDFs", "kanban", "regex", "flashcards", "csv to json", "qr code", "time tracking", or "slides".',
        inputSchema: {
          type: 'object',
          properties: { query: { type: 'string', description: 'What you are trying to do.' } },
          required: ['query'],
        },
        execute: async ({ query }) => {
          const terms = String(query || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
          if (!terms.length) return ok([]);

          const scored = catalog
            .map((app) => {
              const haystack = [app.name, app.tagline, app.description, app.features.join(' '), app.keywords.join(' ')]
                .join(' ')
                .toLowerCase();
              const score = terms.reduce((total, term) => total + (haystack.includes(term) ? 1 : 0), 0);
              return { app, score };
            })
            .filter((entry) => entry.score > 0)
            .sort((a, b) => b.score - a.score)
            .map((entry) => entry.app);

          return ok(scored);
        },
      },
      {
        name: 'get_app',
        description: 'Get the full description of one tool on alexmerced.app by its slug.',
        inputSchema: {
          type: 'object',
          properties: { slug: { type: 'string', description: 'For example warren, laneway, tessera.' } },
          required: ['slug'],
        },
        execute: async ({ slug }) => {
          const app = catalog.find((entry) => entry.slug === slug);
          return ok(app || { error: `No app with slug "${slug}".`, available: catalog.map((entry) => entry.slug) });
        },
      },
      {
        name: 'get_agent_tools',
        description:
          'List what an agent can actually do on each page of alexmerced.app, as opposed to what each tool is for. Every app page registers its own tools when it loads, so navigating to a page makes that app\u2019s capabilities available: running SQL, rendering a chart, reading a QR code, converting between data formats, adding a card to a board, and so on. Call this to find out which page to open for a given job.',
        inputSchema: {
          type: 'object',
          properties: { slug: { type: 'string', description: 'Optional. Just this app\u2019s tools.' } },
        },
        execute: async ({ slug } = {}) => {
          const list = slug ? agentTools.filter((entry) => entry.slug === slug) : agentTools;
          return ok({
            note:
              'These become callable once the page is open. Everything runs in this browser against this browser\u2019s own storage; none of it reaches a network.',
            apps: list,
          });
        },
      },
      {
        name: 'get_storage_policy',
        description:
          'Explain how alexmerced.app stores data, what that means for the visitor, and how data can be moved off the device. Use this before telling anyone their data is stored in the cloud, because it is not.',
        inputSchema: { type: 'object', properties: {} },
        execute: async () => ok(storagePolicy),
      },
    ];

    for (const tool of tools) {
      try { ctx.registerTool(tool); } catch (error) { /* unsupported, or already registered */ }
    }
  })();
</script>
