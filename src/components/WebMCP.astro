---
/**
 * Registers the site-wide agent tools on every page.
 *
 * The tools themselves live in src/lib/siteTools.ts rather than in an inline
 * script here, so they can use the guide builder directly and be covered by the
 * same tests as everything else. An inline script would have needed its own
 * copy of that logic, and a copy is a thing that goes stale.
 */
---

<script>
  import { registerSiteTools } from '../lib/siteTools';
  registerSiteTools();
</script>
