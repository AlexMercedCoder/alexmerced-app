---
import '../styles/global.css';
import { apps } from '../data/apps';

export interface Props {
  title: string;
  description: string;
  /** Slug of the app this page is, if any. Sets the accent and header label. */
  app?: string;
  jsonLd?: Record<string, unknown>[];
  keywords?: string[];
  /** App pages manage their own scrolling and hide the site footer. */
  chrome?: 'site' | 'app';
}

const { title, description, app, jsonLd = [], keywords = [], chrome = 'site' } = Astro.props;

const SITE = 'https://alexmerced.app';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE).href;
const entry = app ? apps.find((candidate) => candidate.slug === app) : undefined;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} · alexmerced.app`;

const baseGraph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'alexmerced.app',
    url: `${SITE}/`,
    description:
      'A shelf of small browser tools by Alex Merced. Every one runs entirely on your own machine, stores its data locally, and lets you export it to a file whenever you want.',
    inLanguage: 'en-US',
    author: { '@id': `${SITE}/#alexmerced` },
  },
  {
    '@type': 'Person',
    '@id': `${SITE}/#alexmerced`,
    name: 'Alex Merced',
    url: 'https://alexmerced.com',
    sameAs: ['https://github.com/alexmercedcoder', 'https://www.linkedin.com/in/alexmerced'],
  },
];

const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...jsonLd] };
---

<!doctype html>
<html lang="en" data-theme={entry?.theme ?? 'shelf'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Alex Merced" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={entry?.accent ?? '#5b6bd6'} />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="alexmerced.app" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content="alexmerced.app" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="am.app" />
    <meta name="mobile-web-app-capable" content="yes" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <div class="shell shell--wide site-header__inner">
        <a class="brand" href="/">
          <span class="brand__dot" aria-hidden="true">a</span>
          <span class="brand__name">alexmerced<span style="color: var(--text-faint)">.app</span></span>
          {entry && <span class="brand__app" aria-hidden="true">/ {entry.name}</span>}
        </a>
        <span class="offline-badge" id="offline-badge" hidden>Offline</span>
        <button class="btn btn--sm install-btn" id="install-app" hidden>Install</button>
        <nav class="header-nav" aria-label="Apps">
          {apps.map((item) => (
            <a href={`/${item.slug}`} aria-current={item.slug === app ? 'page' : undefined}>{item.name}</a>
          ))}
          <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {chrome === 'site' && (
      <footer class="site-footer">
        <div class="shell shell--wide site-footer__row">
          <span>Built by <a href="https://alexmerced.com">Alex Merced</a>. Everything here runs in your browser.</span>
          <nav class="site-footer__links" aria-label="Footer">
            <a href="/">All apps</a>
            <a href="/about">About</a>
            <a href="https://github.com/AlexMercedCoder/alexmerced-app">Source</a>
          </nav>
        </div>
      </footer>
    )}

    <div class="toast-stack" id="toast-stack" role="status" aria-live="polite"></div>

    <script>
      import { setupPwa } from '../lib/pwa';
      setupPwa();
    </script>
  </body>
</html>
