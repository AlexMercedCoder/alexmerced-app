---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('foolscap');
---
<Base title="Foolscap, a document scanner that keeps the paperwork private" description={app.description} app="foolscap" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="foolscap-root">
    <AppBar app="foolscap">
      <button class="btn btn--sm" id="fs-zip" disabled>Images as ZIP</button>
      <button class="btn btn--sm btn--primary" id="fs-pdf" disabled>Download PDF</button>
    </AppBar>

    <div class="shell shell--wide fs">
      <aside class="fs-side">
        <button class="btn btn--primary fs-wide" id="fs-camera-start">Use the camera</button>
        <div class="fs-drop" id="fs-drop">
          <button class="btn btn--sm" id="fs-add">Add a photo</button>
          <p>or drop one here</p>
          <input type="file" id="fs-file" accept="image/*" hidden />
        </div>

        <h2 class="fs-subhead">Finish</h2>
        <select class="field" id="fs-finish" aria-label="Finish"></select>
        <p class="fs-note" id="fs-finish-note"></p>
        <label class="field-row"><span>Strength</span><input class="fs-range" id="fs-strength" type="range" min="0.2" max="3" step="0.1" /></label>

        <h2 class="fs-subhead fs-subhead--spaced">Output</h2>
        <label class="field-row"><span>Document name</span><input class="field" id="fs-title" value="Scan" /></label>
        <label class="field-row"><span>PDF page size</span><select class="field" id="fs-size"></select></label>
        <label class="field-row"><span>JPEG quality</span><input class="fs-range" id="fs-quality" type="range" min="0.3" max="1" step="0.02" /></label>
        <label class="field-row"><span>Capture at most</span>
          <select class="field" id="fs-maxedge">
            <option value="1200">1200 px on the long edge</option>
            <option value="1600">1600 px</option>
            <option value="2000">2000 px</option>
            <option value="3000">3000 px</option>
            <option value="4000">4000 px</option>
          </select>
        </label>
        <p class="fs-storage" id="fs-storage"></p>
      </aside>

      <main class="fs-main">
        <div class="fs-camera" id="fs-camera" hidden>
          <video id="fs-video" playsinline muted></video>
          <button class="btn btn--primary fs-shutter" id="fs-shutter">Capture</button>
        </div>

        <div class="fs-stage" id="fs-stage" hidden>
          <div class="fs-framewrap">
            <canvas id="fs-frame" class="fs-frame"></canvas>
            <canvas id="fs-overlay" class="fs-overlay"></canvas>
          </div>
          <p class="fs-hint" id="fs-hint"></p>
          <div class="fs-stagebar">
            <button class="btn btn--sm" id="fs-redetect">Find the page again</button>
            <button class="btn btn--sm" id="fs-reset-corners">Whole photo</button>
            <button class="btn btn--sm" id="fs-discard">Discard</button>
            <button class="btn btn--primary" id="fs-keep">Straighten and keep</button>
          </div>
        </div>

        <h2 class="fs-subhead">Pages</h2>
        <div class="fs-pages" id="fs-pages"></div>
        <div class="empty" id="fs-empty">
          <strong>No pages yet</strong>
          <p>Point the camera at a document, or add a photo you already have. Everything is processed here in the browser.</p>
        </div>
      </main>
    </div>
  </div>
</Base>

<script>
  import { mountFoolscap } from '../apps/foolscap/ui';
  const root = document.getElementById('foolscap-root');
  if (root) void mountFoolscap(root as HTMLElement);
</script>

<style is:global>
  .fs { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 1.25rem; align-items: start; padding: 1.25rem 0 3rem; }
  .fs-subhead { font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .fs-subhead--spaced { margin-top: 1.1rem; }
  .fs-note { font-size: 0.78rem; color: var(--ink-soft); margin: 0 0 0.6rem; }
  .fs-side { min-width: 0; display: grid; gap: 0.5rem; align-content: start; }
  .fs-wide { width: 100%; }
  .fs-drop { display: grid; gap: 0.3rem; justify-items: center; padding: 0.85rem; border: 1px dashed var(--rule); border-radius: 0.6rem; text-align: center; }
  .fs-drop.is-over { border-color: var(--accent); background: var(--accent-soft); }
  .fs-drop p { margin: 0; font-size: 0.78rem; color: var(--ink-soft); }
  .fs-range { width: 100%; }
  .fs-storage { font-size: 0.74rem; color: var(--ink-soft); margin: 0.6rem 0 0; }

  .fs-main { min-width: 0; display: grid; gap: 0.85rem; }
  .fs-camera { position: relative; border: 1px solid var(--rule); border-radius: 0.6rem; overflow: hidden; background: #111; }
  .fs-camera video { display: block; width: 100%; max-height: 62vh; object-fit: contain; }
  .fs-shutter { position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%); }

  .fs-stage { display: grid; gap: 0.6rem; }
  .fs-framewrap { position: relative; line-height: 0; border: 1px solid var(--rule); border-radius: 0.6rem; overflow: hidden; background: var(--paper-raised); }
  .fs-frame, .fs-overlay { display: block; width: 100%; height: auto; }
  .fs-overlay { position: absolute; inset: 0; touch-action: none; cursor: grab; }
  .fs-hint { margin: 0; font-size: 0.82rem; padding: 0.4rem 0.6rem; border-radius: 0.4rem; }
  .fs-hint[data-state='good'] { color: #14532d; background: #dcfce7; border: 1px solid #86efac; }
  .fs-hint[data-state='warn'] { color: #92400e; background: #fef3c7; border: 1px solid #fcd34d; }
  .fs-stagebar { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .fs-pages { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.75rem; }
  .fs-page { border: 1px solid var(--rule); border-radius: 0.5rem; overflow: hidden; background: var(--paper-raised); display: grid; }
  .fs-page img { display: block; width: 100%; height: 190px; object-fit: contain; background: #fff; }
  .fs-page__bar { display: flex; align-items: center; gap: 0.2rem; padding: 0.3rem 0.45rem; border-top: 1px solid var(--rule); }
  .fs-page__bar span { flex: 1; font-size: 0.76rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .fs-page__bar button { border: 0; background: none; cursor: pointer; color: var(--ink-soft); font-size: 0.95rem; line-height: 1; padding: 0.2rem 0.35rem; border-radius: 0.25rem; }
  .fs-page__bar button:hover:not(:disabled) { background: var(--accent-soft); color: var(--accent); }
  .fs-page__bar button:disabled { opacity: 0.3; cursor: default; }
  .fs-page__bar button:last-child:hover { background: #fee2e2; color: #b91c1c; }

  @media (max-width: 860px) {
    .fs { grid-template-columns: minmax(0, 1fr); }
    .fs-pages { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
    .fs-page img { height: 150px; }
  }
</style>
