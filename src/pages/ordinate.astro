---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('ordinate');
---
<Base title="Ordinate, paste data and get a chart" description={app.description} app="ordinate" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="ordinate-root">
    <AppBar app="ordinate">
      <button class="btn btn--sm" id="or-copy-svg">Copy SVG</button>
      <button class="btn btn--sm" id="or-svg">Download SVG</button>
      <select class="field field--sm or-scale" id="or-scale" aria-label="PNG scale">
        <option value="1">1x</option>
        <option value="2" selected>2x</option>
        <option value="3">3x</option>
        <option value="4">4x</option>
      </select>
      <button class="btn btn--sm btn--primary" id="or-png">Download PNG</button>
    </AppBar>

    <div class="shell shell--wide or">
      <aside class="or-left">
        <div class="or-head">
          <h2 class="or-subhead">Charts</h2>
          <button class="btn btn--sm btn--primary" id="or-new">New</button>
        </div>
        <div class="or-list" id="or-list"></div>

        <h2 class="or-subhead or-subhead--spaced">Data</h2>
        <p class="or-note">Paste CSV, tab separated text from a spreadsheet, or JSON. It stays in this browser.</p>
        <textarea class="or-source" id="or-source" spellcheck="false" aria-label="Chart data"></textarea>
        <div class="or-head">
          <p class="or-note" id="or-summary"></p>
          <button class="btn btn--sm btn--ghost" id="or-sample">Sample</button>
        </div>
      </aside>

      <main class="or-main">
        <div class="or-canvas" id="or-canvas"></div>
        <p class="or-warning" id="or-warning" hidden></p>

        <div class="or-types" id="or-types" role="group" aria-label="Chart type"></div>
      </main>

      <aside class="or-right">
        <label class="field-row"><span>Chart name</span><input class="field" id="or-name" /></label>

        <h2 class="or-subhead or-subhead--spaced">Columns</h2>
        <label class="field-row"><span>Labels from</span><select class="field" id="or-label"></select></label>
        <p class="or-note" id="or-series-note"></p>
        <div class="or-chips" id="or-series"></div>

        <h2 class="or-subhead or-subhead--spaced">Captions</h2>
        <input class="field" id="or-title" placeholder="Title" />
        <input class="field" id="or-subtitle" placeholder="Subtitle" />
        <input class="field" id="or-xlabel" placeholder="Horizontal axis label" />
        <input class="field" id="or-ylabel" placeholder="Vertical axis label" />

        <h2 class="or-subhead or-subhead--spaced">Colours</h2>
        <div class="or-palettes" id="or-palettes"></div>
        <div class="or-bg">
          <label class="field-row"><span>Background</span><input type="color" class="field or-color" id="or-background" /></label>
          <button class="btn btn--sm" id="or-transparent" aria-pressed="false">Transparent</button>
        </div>

        <h2 class="or-subhead or-subhead--spaced">Options</h2>
        <div class="or-toggles">
          <label><input type="checkbox" id="or-legend" /><span>Legend</span></label>
          <label><input type="checkbox" id="or-grid" /><span>Gridlines</span></label>
          <label><input type="checkbox" id="or-values" /><span>Value labels</span></label>
          <label><input type="checkbox" id="or-smooth" /><span>Smooth lines</span></label>
          <label><input type="checkbox" id="or-horizontal" /><span>Horizontal bars</span></label>
        </div>

        <h2 class="or-subhead or-subhead--spaced">Size</h2>
        <div class="or-size">
          <label class="field-row"><span>Width</span><input class="field" id="or-width" type="number" min="240" max="2400" step="20" /></label>
          <label class="field-row"><span>Height</span><input class="field" id="or-height" type="number" min="240" max="2400" step="20" /></label>
        </div>

        <div class="or-danger">
          <button class="btn btn--sm btn--danger" id="or-delete">Delete chart</button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { mountOrdinate } from '../apps/ordinate/ui';
  const root = document.getElementById('ordinate-root');
  if (root) void mountOrdinate(root as HTMLElement);
</script>

<style is:global>
  .or { display: grid; grid-template-columns: 260px minmax(0, 1fr) 250px; gap: 1.25rem; align-items: start; padding: 1.25rem 0 3rem; }
  .or-subhead { font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .or-subhead--spaced { margin-top: 1.15rem; }
  .or-note { font-size: 0.78rem; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .or-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .or-head .or-subhead, .or-head .or-note { margin: 0; }

  .or-left, .or-right { min-width: 0; display: grid; gap: 0.4rem; align-content: start; }
  .or-list { display: grid; gap: 0.35rem; max-height: 190px; overflow: auto; }
  .or-row { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; text-align: left; padding: 0.5rem 0.6rem; border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--paper-raised); cursor: pointer; font: inherit; color: inherit; }
  .or-row strong { font-weight: 600; font-size: 0.88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .or-row span { font-size: 0.7rem; color: var(--ink-soft); }
  .or-row:hover { border-color: var(--accent); }
  .or-row[aria-current='true'] { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }

  .or-source { width: 100%; min-height: 260px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; line-height: 1.5; padding: 0.6rem; border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--paper); color: inherit; }

  .or-main { min-width: 0; display: grid; gap: 0.85rem; }
  .or-canvas { border: 1px solid var(--rule); border-radius: 0.6rem; background: var(--paper-raised); padding: 0.75rem; overflow: auto; }
  .or-canvas svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }
  .or-warning { margin: 0; font-size: 0.8rem; color: #92400e; background: #fef3c7; border: 1px solid #fcd34d; border-radius: 0.4rem; padding: 0.45rem 0.6rem; }

  .or-types { display: grid; grid-template-columns: repeat(auto-fit, minmax(92px, 1fr)); gap: 0.4rem; }
  .or-type { display: grid; justify-items: center; gap: 0.25rem; padding: 0.55rem 0.3rem; border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--paper-raised); cursor: pointer; font: inherit; font-size: 0.72rem; color: var(--ink-soft); }
  .or-type:hover { border-color: var(--accent); color: var(--ink); }
  .or-type[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  .or-chips { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .or-chip { padding: 0.28rem 0.55rem; border: 1px solid var(--rule); border-radius: 999px; background: var(--paper-raised); cursor: pointer; font: inherit; font-size: 0.76rem; color: var(--ink-soft); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .or-chip[aria-pressed='true'] { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); font-weight: 600; }

  .or-palettes { display: grid; gap: 0.3rem; }
  .or-palette { display: flex; gap: 2px; padding: 0.25rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper-raised); cursor: pointer; }
  .or-palette i { flex: 1; height: 14px; border-radius: 2px; }
  .or-palette[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }

  .or-bg { display: flex; align-items: end; gap: 0.5rem; margin-top: 0.5rem; }
  .or-color { padding: 0.15rem; height: 2.1rem; min-width: 3rem; }
  .or-toggles { display: grid; gap: 0.35rem; }
  .or-toggles label { display: flex; align-items: center; gap: 0.45rem; font-size: 0.83rem; }
  .or-size { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .or-scale { max-width: 4.5rem; }
  .or-danger { margin-top: 1.1rem; padding-top: 0.8rem; border-top: 1px solid var(--rule); }

  @media (max-width: 1150px) {
    .or { grid-template-columns: minmax(0, 1fr) 250px; }
    .or-left { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; }
    .or-left > .or-subhead, .or-left > .or-note, .or-left > .or-source, .or-left > .or-head:last-child { grid-column: 2; }
    .or-left > .or-head:first-child, .or-left > .or-list { grid-column: 1; }
    .or-source { min-height: 170px; }
  }
  @media (max-width: 820px) {
    .or { grid-template-columns: minmax(0, 1fr); }
    .or-left { grid-template-columns: minmax(0, 1fr); }
    .or-left > * { grid-column: 1 !important; }
    .or-list { max-height: 150px; }
  }
</style>
