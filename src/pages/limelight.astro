---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('limelight');
---
<Base title="Limelight, record your screen and make it look deliberate" description={app.description} app="limelight" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="limelight-root">
    <AppBar app="limelight">
      <button class="btn btn--sm" id="ll-open">Open a video</button>
      <button class="btn btn--sm" id="ll-save-raw">Save the raw file</button>
      <button class="btn btn--sm btn--primary" id="ll-export">Export</button>
      <input type="file" id="ll-file" accept="video/*" hidden />
    </AppBar>

    <div class="shell shell--wide ll">
      <section class="card ll-capture">
        <div class="ll-capture__row">
          <button class="btn btn--primary ll-recordbtn" id="ll-record">Record</button>
          <span class="ll-clock" id="ll-clock"></span>
        </div>
        <div class="ll-capture__options">
          <label class="ll-radio"><input type="radio" name="ll-source" id="ll-source-screen" checked /><span>Any window or screen</span></label>
          <label class="ll-radio"><input type="radio" name="ll-source" id="ll-source-tab" /><span>This tab</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-mic" /><span>Microphone</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-system-audio" /><span>System audio</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-camera" /><span>Camera</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-camera-blur" /><span>Blur behind me</span></label>
          <label class="field-row ll-countdown-pick">
            <span>Countdown</span>
            <select class="field" id="ll-countdown">
              <option value="0">None</option>
              <option value="3">3</option>
              <option value="5">5</option>
              <option value="10">10</option>
            </select>
          </label>
          <label class="ll-check"><input type="checkbox" id="ll-countdown-sound" /><span>Count out loud</span></label>
        </div>
        <div class="ll-capture__options ll-devices" id="ll-devices" hidden>
          <label class="field-row ll-devicepick" id="ll-mic-pick" hidden>
            <span>Microphone</span>
            <select class="field" id="ll-mic-device"></select>
          </label>
          <label class="field-row ll-devicepick" id="ll-camera-pick" hidden>
            <span>Camera</span>
            <select class="field" id="ll-camera-device"></select>
          </label>
          <button class="btn btn--sm btn--ghost" id="ll-devices-refresh">Rescan</button>
        </div>
        <p class="ll-note" id="ll-devices-note" hidden>
          Device names appear once you have allowed access at least once. Until then a browser
          only says how many there are.
        </p>
        <p class="ll-note">
          Recording this tab is the only case where a browser knows where your pointer is, so it is the
          only case where the zoom can follow your cursor exactly. Recording anything else still works:
          the zoom follows where the picture changes instead, which needs no cursor at all.
        </p>
      </section>

      <section class="card ll-projects-panel">
        <div class="ll-head">
          <h2 class="ll-subhead">Recordings kept here</h2>
          <span class="ll-storage" id="ll-storage"></span>
        </div>
        <div class="ll-projects" id="ll-projects"></div>
        <div class="empty" id="ll-projects-empty">
          <strong>Nothing saved yet</strong>
          <p>A recording is kept in this browser as soon as it stops, so closing the tab or reloading will not lose it.</p>
        </div>
      </section>

      <p class="ll-status" id="ll-status" data-state="idle">Nothing recorded yet.</p>
      <div class="ll-bar" id="ll-bar" hidden><div class="ll-bar__fill" id="ll-bar-fill"></div></div>
      <p class="ll-source-note" id="ll-source-note" hidden></p>

      <div class="ll-stage" id="ll-stage" hidden>
        <canvas id="ll-preview" class="ll-preview"></canvas>
        <div class="ll-transport">
          <button class="ll-icon" id="ll-to-start" title="Back to the start" aria-label="Back to the start">&#9198;</button>
          <button class="ll-icon" id="ll-step-back" title="Back one frame" aria-label="Back one frame">&#9666;</button>
          <button class="ll-icon ll-icon--play" id="ll-play" title="Play" aria-label="Play">&#9654;</button>
          <button class="ll-icon" id="ll-step-fwd" title="Forward one frame" aria-label="Forward one frame">&#9656;</button>
          <button class="ll-icon" id="ll-to-end" title="Skip to the end" aria-label="Skip to the end">&#9197;</button>
          <input type="range" id="ll-scrub" class="ll-scrub" min="0" max="10" step="0.04" value="0" aria-label="Preview position" />
          <span class="ll-time" id="ll-time">0:00</span>
          <span class="ll-time ll-time--total" id="ll-total"></span>
          <button class="ll-icon ll-icon--wide" id="ll-loop" title="Loop the trimmed range" aria-label="Loop the trimmed range" aria-pressed="false">Loop</button>
          <label class="ll-vol" id="ll-vol-wrap">
            <button class="ll-icon" id="ll-mute" title="Mute" aria-label="Mute" aria-pressed="false">&#128266;</button>
            <input type="range" id="ll-vol" min="0" max="1" step="0.05" value="1" aria-label="Volume" />
          </label>
        </div>

        <div class="ll-trim" id="ll-trim" aria-label="Trim range">
          <div class="ll-trim__range" id="ll-trim-range"></div>
        </div>
        <div class="ll-scrubrow">
          <button class="btn btn--sm" id="ll-popout" hidden>Pop out</button>
          <button class="btn btn--sm" id="ll-crop">Crop</button>
          <button class="btn btn--sm" id="ll-trim-start">Start here</button>
          <button class="btn btn--sm" id="ll-trim-end">End here</button>
          <button class="btn btn--sm btn--ghost" id="ll-trim-reset">Whole recording</button>
          <span class="ll-time" id="ll-trim-label"></span>
        </div>

        <div class="ll-croprow" id="ll-croprow" hidden>
          <span class="ll-tracklabel">Shape</span>
          <div class="ll-cropaspects" id="ll-crop-aspects"></div>
          <button class="btn btn--sm btn--ghost" id="ll-crop-reset">Whole picture</button>
          <button class="btn btn--sm btn--primary" id="ll-crop-done">Done</button>
          <span class="ll-time" id="ll-crop-label"></span>
        </div>

        <!-- One track at a time. Six of them open at once was the original
             confusion at a larger scale: the picker keeps every track visible
             as a thin strip, so nothing is forgotten, while only the one being
             worked on is full height with its controls. -->
        <div class="ll-picker" id="ll-picker" role="tablist" aria-label="What to edit"></div>

        <div class="ll-track" data-track="sound" id="ll-track-sound" hidden>
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Sound</span>
            <div class="ll-wavewrap" id="ll-wavewrap" aria-label="Waveform, drag to select a stretch">
              <canvas class="ll-wave" id="ll-wave"></canvas>
              <div class="ll-cutbands" id="ll-cutbands"></div>
              <div class="ll-waveselect" id="ll-waveselect" hidden></div>
              <div class="ll-wavehead" id="ll-wavehead"></div>
            </div>
          </div>
          <div class="ll-trackpanel">
            <div class="ll-scrubrow" id="ll-cutrow" hidden>
              <button class="btn btn--sm" id="ll-cut-selection" disabled>Cut the selection</button>
              <button class="btn btn--sm" id="ll-cut-silences">Remove silences</button>
              <button class="btn btn--sm btn--ghost" id="ll-cut-clear" disabled>Keep everything</button>
              <span class="ll-time" id="ll-cut-label"></span>
            </div>
          </div>
        </div>

        <div class="ll-track" data-track="zoom" id="ll-track-zoom">
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Zoom</span>
            <div class="ll-zoomtrack" id="ll-zoomtrack" aria-label="Zoom track"></div>
          </div>
          <div class="ll-trackpanel">
            <p class="ll-note" id="ll-zoom-hint"></p>
            <div class="ll-scrubrow">
              <button class="btn btn--sm btn--primary" id="ll-zoom-add">Add a zoom</button>
              <button class="btn btn--sm" id="ll-reanalyse">Find the action again</button>
              <button class="btn btn--sm btn--ghost" id="ll-zoom-clear">Clear zooms</button>
            </div>
            <div class="ll-zoom-selected" id="ll-zoom-selected" hidden>
              <div class="ll-zoom-head">
                <span class="ll-tracklabel">This zoom</span>
                <button class="btn btn--sm" id="ll-zoom-aim" aria-pressed="false">Aim it</button>
                <button class="btn btn--sm btn--ghost" id="ll-zoom-delete">Delete</button>
              </div>
              <div class="ll-text-fields">
                <label class="ll-slider"><span>How far in</span><input type="range" id="ll-zoom-amount" min="1" max="4" step="0.1" /><em id="ll-zoom-amount-out"></em></label>
                <label class="ll-slider"><span>Across</span><input type="range" id="ll-zoom-x" min="0" max="1" step="0.01" /><em id="ll-zoom-x-out"></em></label>
                <label class="ll-slider"><span>Down</span><input type="range" id="ll-zoom-y" min="0" max="1" step="0.01" /><em id="ll-zoom-y-out"></em></label>
              </div>
              <p class="ll-note" id="ll-aim-note" hidden>
                Drag on the picture to say what this zoom should look at. The bright rectangle is what it will show.
              </p>
            </div>
          </div>
        </div>

        <div class="ll-track" data-track="speed" id="ll-track-speed">
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Speed</span>
            <div class="ll-zoomtrack ll-speedtrack" id="ll-speedtrack" aria-label="Speed track"></div>
          </div>
          <div class="ll-trackpanel">
            <div class="ll-scrubrow">
              <button class="btn btn--sm" id="ll-speed-add">Speed up from here</button>
              <label class="ll-slider ll-speed-pick" id="ll-speed-selected" hidden>
                <span>Pace</span>
                <input type="range" id="ll-speed-amount" min="0.25" max="8" step="0.25" />
                <em id="ll-speed-amount-out"></em>
              </label>
              <button class="btn btn--sm btn--ghost" id="ll-speed-delete" hidden>Back to normal</button>
              <span class="ll-time" id="ll-speed-label"></span>
            </div>
          </div>
        </div>

        <div class="ll-track" data-track="hide" id="ll-track-hide">
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Hide</span>
            <div class="ll-zoomtrack ll-redacttrack" id="ll-redacttrack" aria-label="Redaction track"></div>
          </div>
          <div class="ll-trackpanel">
            <div class="ll-scrubrow">
              <button class="btn btn--sm" id="ll-redact-add">Hide something</button>
              <div class="ll-redact-fields" id="ll-redact-selected" hidden>
                <label class="field-row"><span>Style</span><select class="field" id="ll-redact-style"></select></label>
                <label class="ll-slider"><span>Width</span><input type="range" id="ll-redact-w" min="0.02" max="1" step="0.01" /><em id="ll-redact-w-out"></em></label>
                <label class="ll-slider"><span>Height</span><input type="range" id="ll-redact-h" min="0.02" max="1" step="0.01" /><em id="ll-redact-h-out"></em></label>
                <button class="btn btn--sm" id="ll-redact-point">Follow from here</button>
                <button class="btn btn--sm btn--ghost" id="ll-redact-delete">Delete</button>
              </div>
              <span class="ll-time" id="ll-redact-label"></span>
            </div>
            <p class="ll-note" id="ll-redact-note" hidden>
              Drag on the picture to place what is hidden. It is burnt into the exported video,
              not laid over it.
            </p>
          </div>
        </div>

        <div class="ll-track" data-track="shapes" id="ll-track-shapes">
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Shapes</span>
            <div class="ll-zoomtrack ll-shapetrack" id="ll-shapetrack" aria-label="Shape track"></div>
          </div>
          <div class="ll-trackpanel">
            <div class="ll-scrubrow">
              <select class="field ll-shapekind" id="ll-shape-kind"></select>
              <button class="btn btn--sm" id="ll-shape-add">Add it here</button>
              <div class="ll-redact-fields" id="ll-shape-selected" hidden>
                <div class="ll-swatches" id="ll-shape-colours"></div>
                <label class="ll-slider"><span>Weight</span><input type="range" id="ll-shape-weight" min="0.001" max="0.03" step="0.001" /><em id="ll-shape-weight-out"></em></label>
                <label class="ll-slider"><span>Fade</span><input type="range" id="ll-shape-fade" min="0" max="1.5" step="0.05" /><em id="ll-shape-fade-out"></em></label>
                <button class="btn btn--sm btn--ghost" id="ll-shape-delete">Delete</button>
              </div>
              <span class="ll-time" id="ll-shape-label"></span>
            </div>
            <p class="ll-note" id="ll-shape-note" hidden>
              Drag on the picture to place it. An arrow runs from where you press to where you let go.
            </p>
          </div>
        </div>

        <div class="ll-track" data-track="text" id="ll-track-text">
          <div class="ll-zoomrow">
            <span class="ll-tracklabel">Text</span>
            <div class="ll-zoomtrack ll-texttrack" id="ll-texttrack" aria-label="Text track"></div>
          </div>
          <div class="ll-trackpanel">
            <div class="ll-scrubrow">
              <button class="btn btn--sm btn--primary" id="ll-text-add">Add text</button>
            </div>
            <div class="ll-text-selected" id="ll-text-selected" hidden>
              <label class="field-row ll-text-words">
                <span>Words</span>
                <textarea class="field" id="ll-text-words" rows="2"></textarea>
              </label>
              <div class="ll-text-fields">
                <label class="ll-slider"><span>Size</span><input type="range" id="ll-text-size" min="0.02" max="0.2" step="0.005" /><em id="ll-text-size-out"></em></label>
                <label class="ll-slider"><span>Across</span><input type="range" id="ll-text-x" min="0" max="1" step="0.01" /><em id="ll-text-x-out"></em></label>
                <label class="ll-slider"><span>Down</span><input type="range" id="ll-text-y" min="0" max="1" step="0.01" /><em id="ll-text-y-out"></em></label>
                <label class="ll-slider"><span>Plate</span><input type="range" id="ll-text-plate" min="0" max="1" step="0.05" /><em id="ll-text-plate-out"></em></label>
                <label class="ll-slider"><span>Fade</span><input type="range" id="ll-text-fade" min="0" max="1.5" step="0.05" /><em id="ll-text-fade-out"></em></label>
                <label class="field-row"><span>Align</span><select class="field" id="ll-text-align"><option value="left">Left</option><option value="centre">Centre</option><option value="right">Right</option></select></label>
                <label class="field-row"><span>Colour</span><input type="color" class="field ll-text-colour" id="ll-text-colour" /></label>
              </div>
            </div>
          </div>
        </div>

        <p class="ll-keys">
          <span><kbd>Space</kbd> play</span>
          <span><kbd>←</kbd> <kbd>→</kbd> step a frame</span>
          <span><kbd>Z</kbd> add a zoom</span>
          <span><kbd>T</kbd> add text</span>
          <span><kbd>C</kbd> crop</span>
          <span><kbd>I</kbd> start here</span>
          <span><kbd>O</kbd> end here</span>
          <span><kbd>Delete</kbd> remove the selected block</span>
          <span>Right-click a block to duplicate or split it</span>
          <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> undo</span>
        </p>

        <div class="ll-scrubrow">
          <button class="btn btn--sm" id="ll-undo" disabled>Undo</button>
          <button class="btn btn--sm" id="ll-redo" disabled>Redo</button>
          <button class="btn btn--sm btn--danger" id="ll-discard">Discard</button>
        </div>
      </div>

      <div class="ll-editor" id="ll-editor" hidden>
        <details class="ll-group" open>
          <summary class="ll-group__head"><span>Look</span><span class="ll-group__hint">shape, background, angle, saved looks</span></summary>
        <section class="card ll-card">
          <h2 class="ll-subhead">For</h2>
          <p class="ll-note">Sets the shape and the output size together, and shows what will be cut off.</p>
          <div class="ll-presets" id="ll-destinations"></div>
        </section>
        <section class="card ll-card">
          <h2 class="ll-subhead">Background</h2>
          <div class="ll-presets" id="ll-presets"></div>
          <label class="field-row"><span>Output size</span><select class="field" id="ll-size"></select></label>
          <label class="ll-slider"><span>Padding</span><input type="range" id="ll-padding" min="0" max="0.2" step="0.005" /><em id="ll-padding-out"></em></label>
          <label class="ll-slider"><span>Corners</span><input type="range" id="ll-radius" min="0" max="0.1" step="0.002" /><em id="ll-radius-out"></em></label>
          <label class="ll-slider"><span>Shadow</span><input type="range" id="ll-shadow" min="0" max="1" step="0.05" /><em id="ll-shadow-out"></em></label>
          <div class="ll-scrubrow">
            <button class="btn btn--sm" id="ll-wallpaper-pick">Use a picture</button>
            <button class="btn btn--sm btn--ghost" id="ll-wallpaper-clear" hidden>Remove it</button>
            <input type="file" id="ll-wallpaper-file" accept="image/*" hidden />
          </div>
          <p class="ll-note" id="ll-wallpaper-note" hidden></p>
        </section>
        <section class="card ll-card">
          <h2 class="ll-subhead">Angle and arrival</h2>
          <label class="ll-slider"><span>Lean back</span><input type="range" id="ll-tilt-x" min="-45" max="45" step="1" /><em id="ll-tilt-x-out"></em></label>
          <label class="ll-slider"><span>Turn</span><input type="range" id="ll-tilt-y" min="-45" max="45" step="1" /><em id="ll-tilt-y-out"></em></label>
          <label class="ll-slider"><span>Rotate</span><input type="range" id="ll-tilt-rotate" min="-30" max="30" step="1" /><em id="ll-tilt-rotate-out"></em></label>
          <label class="ll-slider"><span>Depth</span><input type="range" id="ll-tilt-depth" min="0" max="1" step="0.05" /><em id="ll-tilt-depth-out"></em></label>
          <button class="btn btn--sm btn--ghost" id="ll-tilt-reset">Lay it flat</button>
          <label class="field-row"><span>How it arrives</span><select class="field" id="ll-motion-in"></select></label>
          <label class="field-row"><span>How it leaves</span><select class="field" id="ll-motion-out"></select></label>
          <label class="ll-slider"><span>How long</span><input type="range" id="ll-motion-seconds" min="0.1" max="3" step="0.05" /><em id="ll-motion-seconds-out"></em></label>
          <p class="ll-note">The arrival is measured from where the export begins, not from the start of the recording.</p>
        </section>
        <section class="card ll-card">
          <h2 class="ll-subhead">Looks</h2>
          <p class="ll-note">
            The background, padding, shadow, tilt, entrance and zoom defaults, saved under
            a name so the next recording can match this one.
          </p>
          <div class="ll-looks" id="ll-looks"></div>
          <div class="ll-scrubrow">
            <input class="field ll-lookname" id="ll-look-name" type="text" placeholder="Name this look" maxlength="40" />
            <button class="btn btn--sm" id="ll-look-save">Save</button>
          </div>
        </section>
        </details>

        <details class="ll-group">
          <summary class="ll-group__head"><span>Words</span><span class="ll-group__hint">transcript and chapters</span></summary>
        <section class="card ll-card">
          <h2 class="ll-subhead">Transcript</h2>
          <p class="ll-note">
            Bring in an SRT or VTT file and the words become subtitles you can burn in.
            Selecting lines and pressing Cut removes those seconds from the video, which is
            the quickest way to take out a sentence you did not mean to say.
          </p>
          <div class="ll-scrubrow ll-listen" id="ll-listen-row">
            <button class="btn btn--sm btn--primary" id="ll-listen">Write it out for me</button>
            <select class="field ll-listen-size" id="ll-listen-size"></select>
            <span class="ll-time" id="ll-listen-note"></span>
          </div>
          <p class="ll-note" id="ll-listen-explain">
            The words are worked out on this machine. Doing that needs a model, which is
            fetched the first time you ask and then kept, and is the only thing on this site
            that touches the network. Your recording stays here.
          </p>

          <div class="ll-scrubrow">
            <button class="btn btn--sm" id="ll-captions-open">Open a transcript</button>
            <button class="btn btn--sm" id="ll-captions-add">Add a line here</button>
            <button class="btn btn--sm btn--ghost" id="ll-captions-srt">Save SRT</button>
            <button class="btn btn--sm btn--ghost" id="ll-captions-vtt">Save VTT</button>
            <input type="file" id="ll-captions-file" accept=".srt,.vtt,text/plain" hidden />
          </div>
          <label class="ll-check"><input type="checkbox" id="ll-captions-burn" /><span>Burn the subtitles into the video</span></label>
          <label class="ll-slider"><span>Subtitle size</span><input type="range" id="ll-caption-size" min="0.02" max="0.12" step="0.005" /><em id="ll-caption-size-out"></em></label>
          <ol class="ll-cues" id="ll-cues"></ol>
          <div class="ll-scrubrow" id="ll-cues-actions" hidden>
            <button class="btn btn--sm" id="ll-cues-cut">Cut the selected lines</button>
            <button class="btn btn--sm btn--ghost" id="ll-cues-clear">Clear the selection</button>
            <span class="ll-time" id="ll-cues-label"></span>
          </div>
        </section>
        <section class="card ll-card" id="ll-chapters-card" hidden>
          <h2 class="ll-subhead">Chapters</h2>
          <p class="ll-note">Press <kbd>M</kbd> while recording to mark a moment. These are what you paste under a video.</p>
          <ol class="ll-chapters" id="ll-chapters"></ol>
          <div class="ll-scrubrow">
            <button class="btn btn--sm" id="ll-chapters-copy">Copy the list</button>
          </div>
        </section>
        </details>

        <details class="ll-group">
          <summary class="ll-group__head"><span>Motion, sound and output</span><span class="ll-group__hint">automatic zoom, camera, audio, format</span></summary>
        <section class="card ll-card">
          <h2 class="ll-subhead">Automatic zoom</h2>
          <p class="ll-note">
            These are the defaults the automatic zooms are built from. To change one zoom,
            click it on the timeline instead.
          </p>
          <label class="ll-check"><input type="checkbox" id="ll-zoom-on" /><span>Zoom in on what is happening</span></label>
          <label class="ll-slider"><span>Default how far in</span><input type="range" id="ll-zoom-scale" min="1" max="3" step="0.05" /><em id="ll-zoom-scale-out"></em></label>
          <label class="ll-slider"><span>How long it stays</span><input type="range" id="ll-zoom-hold" min="0.4" max="4" step="0.1" /><em id="ll-zoom-hold-out"></em></label>
          <label class="ll-slider"><span>How fast it moves</span><input type="range" id="ll-zoom-move" min="0.15" max="1.5" step="0.05" /><em id="ll-zoom-move-out"></em></label>
          <label class="ll-check"><input type="checkbox" id="ll-clicks" /><span>Show a ripple where you clicked</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-cursor" /><span>Draw a smoothed cursor</span></label>
          <label class="ll-slider"><span>Cursor size</span><input type="range" id="ll-cursor-size" min="0.5" max="4" step="0.1" /><em id="ll-cursor-size-out"></em></label>
