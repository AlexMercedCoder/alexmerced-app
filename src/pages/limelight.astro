---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('limelight');
---
<Base title="Limelight, record your screen and make it look deliberate" description={app.description} app="limelight" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="limelight-root">
    <AppBar app="limelight">
      <button class="btn btn--sm" id="ll-open">Open a video</button>
      <button class="btn btn--sm" id="ll-save-raw">Save the raw file</button>
      <button class="btn btn--sm btn--primary" id="ll-export">Export</button>
      <input type="file" id="ll-file" accept="video/*" hidden />
    </AppBar>

    <div class="shell shell--wide ll">
      <section class="card ll-capture">
        <div class="ll-capture__row">
          <button class="btn btn--primary ll-recordbtn" id="ll-record">Record</button>
          <span class="ll-clock" id="ll-clock"></span>
        </div>
        <div class="ll-capture__options">
          <label class="ll-radio"><input type="radio" name="ll-source" id="ll-source-screen" checked /><span>Any window or screen</span></label>
          <label class="ll-radio"><input type="radio" name="ll-source" id="ll-source-tab" /><span>This tab</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-mic" /><span>Microphone</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-system-audio" /><span>System audio</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-camera" /><span>Camera</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-camera-blur" /><span>Blur behind me</span></label>
          <label class="field-row ll-countdown-pick">
            <span>Countdown</span>
            <select class="field" id="ll-countdown">
              <option value="0">None</option>
              <option value="3">3</option>
              <option value="5">5</option>
              <option value="10">10</option>
            </select>
          </label>
          <label class="ll-check"><input type="checkbox" id="ll-countdown-sound" /><span>Count out loud</span></label>
        </div>
        <p class="ll-note">
          Recording this tab is the only case where a browser knows where your pointer is, so it is the
          only case where the zoom can follow your cursor exactly. Recording anything else still works:
          the zoom follows where the picture changes instead, which needs no cursor at all.
        </p>
      </section>

      <section class="card ll-projects-panel">
        <div class="ll-head">
          <h2 class="ll-subhead">Recordings kept here</h2>
          <span class="ll-storage" id="ll-storage"></span>
        </div>
        <div class="ll-projects" id="ll-projects"></div>
        <div class="empty" id="ll-projects-empty">
          <strong>Nothing saved yet</strong>
          <p>A recording is kept in this browser as soon as it stops, so closing the tab or reloading will not lose it.</p>
        </div>
      </section>

      <p class="ll-status" id="ll-status" data-state="idle">Nothing recorded yet.</p>
      <div class="ll-bar" id="ll-bar" hidden><div class="ll-bar__fill" id="ll-bar-fill"></div></div>
      <p class="ll-source-note" id="ll-source-note" hidden></p>

      <div class="ll-stage" id="ll-stage" hidden>
        <canvas id="ll-preview" class="ll-preview"></canvas>
        <div class="ll-scrubrow">
          <input type="range" id="ll-scrub" class="ll-scrub" min="0" max="10" step="0.04" value="0" aria-label="Preview position" />
          <span class="ll-time" id="ll-time">0:00</span>
        </div>

        <div class="ll-trim" id="ll-trim" aria-label="Trim range">
          <div class="ll-trim__range" id="ll-trim-range"></div>
        </div>
        <div class="ll-scrubrow">
          <button class="btn btn--sm" id="ll-crop">Crop</button>
          <button class="btn btn--sm" id="ll-trim-start">Start here</button>
          <button class="btn btn--sm" id="ll-trim-end">End here</button>
          <button class="btn btn--sm btn--ghost" id="ll-trim-reset">Whole recording</button>
          <span class="ll-time" id="ll-trim-label"></span>
        </div>

        <div class="ll-croprow" id="ll-croprow" hidden>
          <span class="ll-tracklabel">Shape</span>
          <div class="ll-cropaspects" id="ll-crop-aspects"></div>
          <button class="btn btn--sm btn--ghost" id="ll-crop-reset">Whole picture</button>
          <button class="btn btn--sm btn--primary" id="ll-crop-done">Done</button>
          <span class="ll-time" id="ll-crop-label"></span>
        </div>

        <div class="ll-zoomrow">
          <span class="ll-tracklabel">Zoom</span>
          <div class="ll-zoomtrack" id="ll-zoomtrack" aria-label="Zoom track"></div>
        </div>
        <p class="ll-note" id="ll-zoom-hint"></p>

        <div class="ll-zoomrow">
          <span class="ll-tracklabel">Text</span>
          <div class="ll-zoomtrack ll-texttrack" id="ll-texttrack" aria-label="Text track"></div>
        </div>

        <div class="ll-text-selected" id="ll-text-selected" hidden>
          <label class="field-row ll-text-words">
            <span>Words</span>
            <textarea class="field" id="ll-text-words" rows="2"></textarea>
          </label>
          <div class="ll-text-fields">
            <label class="ll-slider"><span>Size</span><input type="range" id="ll-text-size" min="0.02" max="0.2" step="0.005" /><em id="ll-text-size-out"></em></label>
            <label class="ll-slider"><span>Across</span><input type="range" id="ll-text-x" min="0" max="1" step="0.01" /><em id="ll-text-x-out"></em></label>
            <label class="ll-slider"><span>Down</span><input type="range" id="ll-text-y" min="0" max="1" step="0.01" /><em id="ll-text-y-out"></em></label>
            <label class="ll-slider"><span>Plate</span><input type="range" id="ll-text-plate" min="0" max="1" step="0.05" /><em id="ll-text-plate-out"></em></label>
            <label class="ll-slider"><span>Fade</span><input type="range" id="ll-text-fade" min="0" max="1.5" step="0.05" /><em id="ll-text-fade-out"></em></label>
            <label class="field-row"><span>Align</span><select class="field" id="ll-text-align"><option value="left">Left</option><option value="centre">Centre</option><option value="right">Right</option></select></label>
            <label class="field-row"><span>Colour</span><input type="color" class="field ll-text-colour" id="ll-text-colour" /></label>
          </div>
        </div>

        <div class="ll-zoom-selected" id="ll-zoom-selected" hidden>
          <label class="ll-slider">
            <span>How far this one goes in</span>
            <input type="range" id="ll-zoom-amount" min="1" max="4" step="0.1" />
            <em id="ll-zoom-amount-out"></em>
          </label>
        </div>

        <p class="ll-keys">
          <span><kbd>Space</kbd> play</span>
          <span><kbd>←</kbd> <kbd>→</kbd> step a frame</span>
          <span><kbd>Z</kbd> add a zoom</span>
          <span><kbd>T</kbd> add text</span>
          <span><kbd>C</kbd> crop</span>
          <span><kbd>I</kbd> start here</span>
          <span><kbd>O</kbd> end here</span>
          <span><kbd>Delete</kbd> remove the selected zoom</span>
          <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> undo</span>
        </p>

        <div class="ll-scrubrow">
          <button class="btn btn--sm btn--primary" id="ll-zoom-add">Add a zoom</button>
          <button class="btn btn--sm btn--primary" id="ll-text-add">Add text</button>
          <button class="btn btn--sm" id="ll-reanalyse">Find the action again</button>
          <button class="btn btn--sm btn--ghost" id="ll-zoom-clear">Clear zooms</button>
          <button class="btn btn--sm" id="ll-undo" disabled>Undo</button>
          <button class="btn btn--sm" id="ll-redo" disabled>Redo</button>
          <button class="btn btn--sm btn--danger" id="ll-discard">Discard</button>
        </div>
      </div>

      <div class="ll-editor" id="ll-editor" hidden>
        <section class="card ll-card">
          <h2 class="ll-subhead">Background</h2>
          <div class="ll-presets" id="ll-presets"></div>
          <label class="field-row"><span>Output size</span><select class="field" id="ll-size"></select></label>
          <label class="ll-slider"><span>Padding</span><input type="range" id="ll-padding" min="0" max="0.2" step="0.005" /><em id="ll-padding-out"></em></label>
          <label class="ll-slider"><span>Corners</span><input type="range" id="ll-radius" min="0" max="0.1" step="0.002" /><em id="ll-radius-out"></em></label>
          <label class="ll-slider"><span>Shadow</span><input type="range" id="ll-shadow" min="0" max="1" step="0.05" /><em id="ll-shadow-out"></em></label>
          <div class="ll-scrubrow">
            <button class="btn btn--sm" id="ll-wallpaper-pick">Use a picture</button>
            <button class="btn btn--sm btn--ghost" id="ll-wallpaper-clear" hidden>Remove it</button>
            <input type="file" id="ll-wallpaper-file" accept="image/*" hidden />
          </div>
          <p class="ll-note" id="ll-wallpaper-note" hidden></p>
        </section>

        <section class="card ll-card">
          <h2 class="ll-subhead">Zoom</h2>
          <label class="ll-check"><input type="checkbox" id="ll-zoom-on" /><span>Zoom in on what is happening</span></label>
          <label class="ll-slider"><span>How far</span><input type="range" id="ll-zoom-scale" min="1" max="3" step="0.05" /><em id="ll-zoom-scale-out"></em></label>
          <label class="ll-slider"><span>How long it stays</span><input type="range" id="ll-zoom-hold" min="0.4" max="4" step="0.1" /><em id="ll-zoom-hold-out"></em></label>
          <label class="ll-slider"><span>How fast it moves</span><input type="range" id="ll-zoom-move" min="0.15" max="1.5" step="0.05" /><em id="ll-zoom-move-out"></em></label>
          <label class="ll-check"><input type="checkbox" id="ll-clicks" /><span>Show a ripple where you clicked</span></label>
          <label class="ll-check"><input type="checkbox" id="ll-cursor" /><span>Draw a smoothed cursor</span></label>
          <p class="ll-note">The cursor and the ripples need a pointer track, so they only appear when you recorded this tab.</p>
        </section>

        <section class="card ll-card">
          <h2 class="ll-subhead">Camera and output</h2>
          <label class="ll-check"><input type="checkbox" id="ll-camera-on" /><span>Show the camera bubble</span></label>
          <div id="ll-camera-fields" hidden>
            <label class="field-row"><span>Corner</span>
              <select class="field" id="ll-camera-corner">
                <option value="bottomRight">Bottom right</option>
                <option value="bottomLeft">Bottom left</option>
                <option value="topRight">Top right</option>
                <option value="topLeft">Top left</option>
              </select>
            </label>
            <label class="ll-slider"><span>Size</span><input type="range" id="ll-camera-size" min="0.1" max="0.4" step="0.01" /><em id="ll-camera-size-out"></em></label>
            <label class="field-row"><span>Shape</span><select class="field" id="ll-camera-shape"></select></label>
          </div>

          <label class="ll-check"><input type="checkbox" id="ll-audio" /><span>Keep the sound that was recorded</span></label>

          <div class="ll-pair">
            <label class="field-row"><span>Format</span>
              <select class="field" id="ll-format">
                <option value="webm">WebM</option>
                <option value="mp4">MP4</option>
                <option value="gif">Animated GIF</option>
              </select>
            </label>
            <label class="field-row"><span>Quality</span><select class="field" id="ll-quality"></select></label>
          </div>
          <p class="ll-note" id="ll-format-note"></p>

          <label class="field-row"><span>Frames a second</span>
            <select class="field" id="ll-fps">
              <option value="24">24</option>
              <option value="30">30</option>
              <option value="60">60</option>
            </select>
          </label>
          <p class="ll-note">Roughly <span id="ll-bitrate-out"></span>. Every frame is drawn and encoded one at a time, so a long recording takes a while and comes out exactly as the preview shows it.</p>
        </section>
      </div>
    </div>
  </div>
</Base>

<script>
  import { mountLimelight } from '../apps/limelight/ui';
  const root = document.getElementById('limelight-root');
  if (root) void mountLimelight(root as HTMLElement);
</script>

<style is:global>

  .ll-zoomrow { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr); align-items: center; gap: 0.5rem; }
  .ll-tracklabel { font-size: 0.7rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-soft); }
  .ll-zoomtrack { position: relative; height: 2.4rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper-raised); touch-action: none; overflow: hidden; }
  .ll-zoom { position: absolute; top: 4px; bottom: 4px; background: var(--accent); opacity: 0.55; border-radius: 0.25rem; cursor: grab; display: flex; align-items: center; justify-content: center; min-width: 10px; }
  .ll-zoom.is-pinned { opacity: 0.85; }
  .ll-zoom.is-selected { outline: 2px solid var(--ink); outline-offset: 1px; }
  .ll-zoom__label { font-size: 0.66rem; color: #fff; font-variant-numeric: tabular-nums; pointer-events: none; white-space: nowrap; }
  .ll-zoom__grip { position: absolute; top: 0; bottom: 0; width: 8px; border: 0; padding: 0; background: rgba(0,0,0,0.25); cursor: ew-resize; }
  .ll-zoom__grip--start { left: 0; border-radius: 0.25rem 0 0 0.25rem; }
  .ll-zoom__grip--end { right: 0; border-radius: 0 0.25rem 0.25rem 0; }
  .ll-zoom-selected { padding: 0.5rem 0.7rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper-raised); }

  .ll-projects-panel { padding: 1rem; display: grid; gap: 0.6rem; }
  .ll-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem; }
  .ll-head .ll-subhead { margin: 0; }
  .ll-storage { font-size: 0.75rem; color: var(--ink-soft); }
  .ll-projects { display: grid; gap: 0.35rem; max-height: 30vh; overflow: auto; }
  .ll-project { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; border: 1px solid var(--rule); border-radius: 0.5rem; background: var(--paper-raised); }
  .ll-project[aria-current='true'] { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .ll-project__open { display: grid; gap: 0.12rem; text-align: left; background: none; border: 0; cursor: pointer; font: inherit; color: inherit; padding: 0.5rem 0.6rem; min-width: 0; }
  .ll-project__open strong { font-size: 0.87rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ll-project__open span { font-size: 0.74rem; color: var(--ink-soft); }
  .ll-project__remove { border: 0; background: none; color: var(--ink-soft); cursor: pointer; font-size: 1.15rem; padding: 0.3rem 0.55rem; }
  .ll-project__remove:hover { color: #b91c1c; }

  .ll-trim { position: relative; height: 2.2rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper-raised); cursor: ew-resize; touch-action: none; overflow: hidden; }
  .ll-trim__range { position: absolute; top: 0; bottom: 0; background: var(--accent); opacity: 0.22; border-left: 2px solid var(--accent); border-right: 2px solid var(--accent); }
  .ll { display: grid; gap: 1rem; padding: 1.25rem 0 3rem; }
  .ll-subhead { font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 0.7rem; }
  .ll-note { font-size: 0.79rem; color: var(--ink-soft); margin: 0.6rem 0 0; line-height: 1.55; }

  .ll-capture { padding: 1rem; display: grid; gap: 0.7rem; }
  .ll-capture__row { display: flex; align-items: center; gap: 0.8rem; }
  .ll-recordbtn { min-width: 8rem; }
  .ll-recordbtn.is-recording { background: #b91c1c; border-color: #b91c1c; animation: ll-pulse 1.4s ease-in-out infinite; }
  @keyframes ll-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.72; } }
  .ll-clock { font-variant-numeric: tabular-nums; font-size: 1rem; color: var(--ink-soft); }
  .ll-capture__options { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; }
  .ll-radio, .ll-check { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; }

  .ll-status { margin: 0; font-size: 0.85rem; padding: 0.5rem 0.7rem; border-radius: 0.4rem; border: 1px solid var(--rule); background: var(--paper-raised); color: var(--ink-soft); }
  .ll-status[data-state='good'] { background: #dcfce7; border-color: #86efac; color: #14532d; }
  .ll-status[data-state='bad'] { background: #fef3c7; border-color: #fcd34d; color: #92400e; }
  .ll-status[data-state='busy'] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .ll-source-note { margin: 0; font-size: 0.82rem; color: var(--ink-soft); padding: 0.45rem 0.7rem; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 0.3rem 0.3rem 0; }

  .ll-bar { height: 6px; border-radius: 999px; background: var(--rule); overflow: hidden; }
  .ll-bar__fill { height: 100%; width: 0; background: var(--accent); transition: width 0.15s linear; }

  .ll-stage { display: grid; gap: 0.6rem; }
  .ll-countdown-pick { gap: 0.4rem; }
  .ll-countdown {
    position: fixed; inset: 0; z-index: 60; display: grid; place-content: center; justify-items: center;
    gap: 0.4rem; background: rgba(8, 8, 10, 0.82); color: #fff; text-align: center;
  }
  .ll-countdown span { font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.75; }
  .ll-countdown strong { font-size: clamp(5rem, 22vw, 14rem); line-height: 1; font-variant-numeric: tabular-nums; animation: ll-pop 0.9s ease-out; }
  @keyframes ll-pop { from { transform: scale(0.72); opacity: 0.2; } 40% { transform: scale(1.04); opacity: 1; } to { transform: scale(1); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ll-countdown strong { animation: none; } }
  .ll-texttrack .ll-zoom { background: color-mix(in srgb, var(--accent, #5b7cfa) 26%, transparent); }
  .ll-text-selected { display: grid; gap: 0.6rem; padding: 0.6rem; border: 1px solid var(--rule); border-radius: 0.5rem; }
  .ll-text-words textarea { font: inherit; resize: vertical; }
  .ll-text-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.4rem 1rem; }
  .ll-text-colour { padding: 0; height: 2rem; }
  .ll-keys { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: 0.82rem; color: var(--muted); }
  .ll-keys kbd { font: inherit; font-weight: 600; padding: 0.05rem 0.35rem; border: 1px solid var(--rule); border-radius: 0.3rem; background: var(--surface); color: var(--ink); }
  .ll-preview.is-cropping { cursor: crosshair; }
  .ll-croprow { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .ll-cropaspects { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .ll-cropaspect { font: inherit; font-size: 0.8rem; padding: 0.2rem 0.55rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--surface); color: inherit; cursor: pointer; }
  .ll-cropaspect[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ll-preview { display: block; width: 100%; max-height: 62vh; object-fit: contain; border: 1px solid var(--rule); border-radius: 0.6rem; background: repeating-conic-gradient(#e8e8e8 0% 25%, #fbfbfb 0% 50%) 50% / 20px 20px; }
  .ll-scrubrow { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .ll-scrub { flex: 1 1 240px; min-width: 0; }
  .ll-time { font-variant-numeric: tabular-nums; font-size: 0.82rem; color: var(--ink-soft); min-width: 3rem; }

  .ll-editor { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; align-items: start; }
  .ll-card { padding: 1rem; min-width: 0; display: grid; gap: 0.55rem; align-content: start; }
  .ll-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }
  .ll-presets { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.3rem; }
  .ll-preset { width: 42px; height: 30px; border-radius: 0.35rem; border: 2px solid transparent; box-shadow: 0 0 0 1px var(--rule); cursor: pointer; padding: 0; }
  .ll-preset[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .ll-slider { display: grid; grid-template-columns: 8rem minmax(0, 1fr) 3.2rem; align-items: center; gap: 0.5rem; font-size: 0.83rem; }
  .ll-slider em { font-style: normal; font-variant-numeric: tabular-nums; color: var(--ink-soft); font-size: 0.78rem; text-align: right; }

  @media (max-width: 620px) {
    .ll-slider { grid-template-columns: minmax(0, 1fr) 3.2rem; }
    .ll-slider > span { grid-column: 1 / -1; }
  }
</style>
