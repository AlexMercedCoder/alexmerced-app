---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('tally');
---
<Base title="Tally, an invoice builder that never uploads your books" description={app.description} app="tally" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="tally-root">
    <AppBar app="tally">
      <button class="btn btn--sm" id="ty-copy-text">Copy as text</button>
      <button class="btn btn--sm" id="ty-csv">CSV</button>
      <button class="btn btn--sm btn--primary" id="ty-pdf">Download PDF</button>
    </AppBar>

    <div class="shell shell--wide ty">
      <aside class="ty-side">
        <div class="ty-side__head">
          <h2 class="ty-subhead">Invoices</h2>
          <button class="btn btn--sm btn--primary" id="ty-new">New</button>
        </div>
        <div class="ty-list" id="ty-list"></div>
        <div class="empty" id="ty-list-empty" hidden>
          <strong>No invoices yet</strong>
          <p>Press New to start one.</p>
        </div>
      </aside>

      <div class="ty-editor" id="ty-editor">
        <section class="card ty-card">
          <div class="ty-meta">
            <label class="field-row"><span>Number</span><input class="field" id="ty-number" autocomplete="off" /></label>
            <label class="field-row"><span>Issued</span><input class="field" id="ty-issued" type="date" /></label>
            <label class="field-row"><span>Due</span><input class="field" id="ty-due" type="date" /></label>
            <label class="field-row ty-narrow"><span>Symbol</span><input class="field" id="ty-symbol" maxlength="3" /></label>
            <label class="field-row ty-narrow"><span>Code</span><input class="field" id="ty-currency" maxlength="4" /></label>
            <label class="ty-paid"><input type="checkbox" id="ty-paid" /><span>Marked paid</span></label>
          </div>
        </section>

        <div class="ty-parties">
          <section class="card ty-card">
            <h2 class="ty-subhead">From</h2>
            <p class="ty-hint">Remembered for the next invoice you start.</p>
            <input class="field" id="ty-from-name" placeholder="Your name or company" />
            <textarea class="field" id="ty-from-address" rows="2" placeholder="Address"></textarea>
            <input class="field" id="ty-from-email" placeholder="Email" />
            <input class="field" id="ty-from-reference" placeholder="Tax or company number" />
          </section>

          <section class="card ty-card">
            <h2 class="ty-subhead">Bill to</h2>
            <p class="ty-hint">Who owes the money.</p>
            <input class="field" id="ty-to-name" placeholder="Client name" />
            <textarea class="field" id="ty-to-address" rows="2" placeholder="Address"></textarea>
            <input class="field" id="ty-to-email" placeholder="Email" />
            <input class="field" id="ty-to-reference" placeholder="Purchase order or reference" />
          </section>
        </div>

        <section class="card ty-card">
          <div class="ty-side__head">
            <h2 class="ty-subhead">Lines</h2>
            <button class="btn btn--sm" id="ty-add-item">Add line</button>
          </div>
          <div class="ty-items-head" aria-hidden="true">
            <span>Description</span><span>Qty</span><span>Unit</span><span>Tax</span><span>Amount</span><span></span>
          </div>
          <div class="ty-items" id="ty-items"></div>
        </section>

        <div class="ty-lower">
          <section class="card ty-card">
            <h2 class="ty-subhead">Adjustments</h2>
            <div class="ty-adjust">
              <label class="field-row"><span>Default tax rate</span><input class="field" id="ty-default-tax" inputmode="decimal" placeholder="0" /></label>
              <label class="field-row"><span>Tax label</span><input class="field" id="ty-tax-label" placeholder="Tax" /></label>
              <label class="field-row"><span>Discount</span>
                <select class="field" id="ty-discount-kind">
                  <option value="none">None</option>
                  <option value="percent">Percentage</option>
                  <option value="fixed">Fixed amount</option>
                </select>
              </label>
              <div class="field-row" id="ty-discount-row" hidden>
                <span>Amount</span><input class="field" id="ty-discount-value" inputmode="decimal" />
              </div>
            </div>
            <div class="ty-totals" id="ty-totals"></div>
          </section>

          <section class="card ty-card">
            <h2 class="ty-subhead">Notes and terms</h2>
            <textarea class="field" id="ty-notes" rows="3" placeholder="Thank you. Bank details on request."></textarea>
            <textarea class="field" id="ty-terms" rows="3" placeholder="Payment due within 30 days."></textarea>
            <h2 class="ty-subhead ty-subhead--spaced">Look</h2>
            <div class="ty-accents" id="ty-accents"></div>
            <label class="field-row"><span>Typeface</span>
              <select class="field" id="ty-font">
                <option value="sans">Sans serif</option>
                <option value="serif">Serif</option>
              </select>
            </label>
            <div class="ty-danger">
              <button class="btn btn--sm" id="ty-duplicate">Duplicate</button>
              <button class="btn btn--sm btn--danger" id="ty-delete">Delete invoice</button>
            </div>
          </section>
        </div>
      </div>

      <aside class="ty-preview">
        <h2 class="ty-subhead">Preview</h2>
        <iframe id="ty-preview" title="Invoice preview"></iframe>
        <p class="ty-hint">This is the actual PDF, drawn in your browser. Nothing is sent anywhere.</p>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { mountTally } from '../apps/tally/ui';
  const root = document.getElementById('tally-root');
  if (root) void mountTally(root as HTMLElement);
</script>

<style is:global>
  .ty { display: grid; grid-template-columns: 230px minmax(0, 1fr) 300px; gap: 1.25rem; align-items: start; padding: 1.25rem 0 3rem; }
  .ty-subhead { font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 0.5rem; }
  .ty-subhead--spaced { margin-top: 1.1rem; }
  .ty-hint { font-size: 0.78rem; color: var(--ink-soft); margin: 0 0 0.55rem; }
  .ty-card { padding: 1rem; display: grid; gap: 0.5rem; min-width: 0; }

  .ty-side { position: sticky; top: calc(var(--header-h) + 3.6rem); display: grid; gap: 0.6rem; min-width: 0; }
  .ty-side__head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .ty-side__head .ty-subhead { margin: 0; }
  .ty-list { display: grid; gap: 0.4rem; max-height: 60vh; overflow: auto; }
  .ty-row { display: grid; gap: 0.25rem; text-align: left; padding: 0.6rem 0.7rem; border: 1px solid var(--rule); border-radius: 0.6rem; background: var(--paper-raised); cursor: pointer; font: inherit; color: inherit; }
  .ty-row:hover { border-color: var(--accent); }
  .ty-row[aria-current='true'] { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
  .ty-row__top { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .ty-row__client { font-size: 0.82rem; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ty-row__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 0.4rem; font-size: 0.78rem; color: var(--ink-soft); }
  .ty-chip { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.12rem 0.4rem; border-radius: 999px; border: 1px solid var(--rule); }
  .ty-chip--paid { background: #dcfce7; border-color: #86efac; color: #14532d; }
  .ty-chip--overdue { background: #fee2e2; border-color: #fca5a5; color: #7f1d1d; }
  .ty-chip--due { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }

  .ty-editor { display: grid; gap: 1rem; min-width: 0; }
  .ty-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: end; }
  .field-row { display: grid; gap: 0.25rem; min-width: 0; flex: 1 1 150px; }
  .field-row > span { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
  .ty-narrow { flex: 0 0 80px; }
  .ty-paid { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; padding-bottom: 0.5rem; white-space: nowrap; }
  .ty-parties, .ty-lower { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }

  .ty-items-head, .ty-item { display: grid; grid-template-columns: minmax(0, 1fr) 66px 88px 62px 96px 28px; gap: 0.4rem; align-items: start; }
  .ty-items-head { font-size: 0.68rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-soft); padding: 0 0 0.3rem; border-bottom: 1px solid var(--rule); }
  .ty-items-head > span:nth-child(n+2):nth-child(-n+5) { text-align: right; }
  .ty-items { display: grid; gap: 0.4rem; padding-top: 0.5rem; }
  .ty-item { padding-bottom: 0.4rem; border-bottom: 1px solid var(--rule-soft, var(--rule)); }
  .ty-item__desc { resize: none; overflow: hidden; min-height: 2.1rem; padding: 0.4rem 0.5rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper); color: inherit; font: inherit; font-size: 0.88rem; min-width: 0; }
  .ty-item__num { text-align: right; padding: 0.4rem 0.45rem; border: 1px solid var(--rule); border-radius: 0.4rem; background: var(--paper); color: inherit; font: inherit; font-size: 0.85rem; min-width: 0; }
  .ty-item__amount { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; padding-top: 0.55rem; font-size: 0.85rem; }
  .ty-item__remove { border: 0; background: none; color: var(--ink-soft); cursor: pointer; font-size: 1.2rem; line-height: 1; padding: 0.4rem 0; }
  .ty-item__remove:hover { color: #b91c1c; }

  .ty-adjust { display: grid; gap: 0.6rem; }
  .ty-totals { display: grid; gap: 0.3rem; margin-top: 0.85rem; padding-top: 0.7rem; border-top: 1px solid var(--rule); }
  .ty-total { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; color: var(--ink-soft); }
  .ty-total strong { font-variant-numeric: tabular-nums; color: var(--ink); }
  .ty-total--grand { font-size: 1.05rem; padding-top: 0.4rem; border-top: 1px solid var(--rule); }
  .ty-total--grand strong { color: var(--accent); }

  .ty-accents { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .ty-swatch { width: 26px; height: 26px; border-radius: 50%; border: 2px solid transparent; background: var(--swatch); cursor: pointer; padding: 0; }
  .ty-swatch[aria-pressed='true'] { border-color: var(--ink); box-shadow: 0 0 0 2px var(--paper) inset; }
  .ty-danger { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; padding-top: 0.8rem; border-top: 1px solid var(--rule); }

  .ty-preview { position: sticky; top: calc(var(--header-h) + 3.6rem); min-width: 0; }
  .ty-preview iframe { width: 100%; aspect-ratio: 8.5 / 11; border: 1px solid var(--rule); border-radius: 0.5rem; background: #fff; }

  @media (max-width: 1180px) {
    .ty { grid-template-columns: 200px minmax(0, 1fr); }
    .ty-preview { grid-column: 1 / -1; position: static; max-width: 620px; }
  }
  @media (max-width: 760px) {
    .ty { grid-template-columns: minmax(0, 1fr); }
    .ty-side { position: static; }
    .ty-list { max-height: 220px; }
    .ty-items-head { display: none; }
    /* Three rows: the description, then the numbers, then the amount. The
       order shifts because the remove button sits after the amount in the DOM. */
    .ty-item { grid-template-columns: repeat(3, minmax(0, 1fr)) 28px; gap: 0.4rem; padding-bottom: 0.7rem; }
    .ty-item__desc { grid-column: 1 / -1; }
    .ty-item__remove { order: 2; padding-top: 0.3rem; }
    .ty-item__amount { order: 3; grid-column: 1 / -1; padding-top: 0.1rem; }
  }
</style>
