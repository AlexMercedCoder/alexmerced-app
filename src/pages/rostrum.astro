---
import Base from '../layouts/Base.astro';
import AppBar from '../components/AppBar.astro';
import { getApp } from '../data/apps';
const app = getApp('rostrum');
---
<Base title="Rostrum, slides that live in your browser" description={app.description} app="rostrum" chrome="app" keywords={app.keywords}>
  <div class="app-frame" id="rostrum-root" data-presenting="false">
    <AppBar app="rostrum">
      <label class="sr-only" for="rs-deck">Deck</label>
      <select id="rs-deck" class="field field--sm rs-deck"></select>
      <button class="btn btn--sm btn--primary" id="rs-present">Present</button>
      <button class="btn btn--sm" id="rs-presenter">Presenter view</button>
      <button class="btn btn--sm" id="rs-new-deck">New</button>
      <button class="btn btn--sm" id="rs-import-md">Import MD</button>
      <button class="btn btn--sm" id="rs-export-md">MD</button>
      <button class="btn btn--sm" id="rs-export-pdf">PDF</button>
      <button class="btn btn--sm" id="rs-export-html">HTML</button>
      <button class="btn btn--sm btn--danger" id="rs-delete-deck">Delete deck</button>
    </AppBar>

    <div class="rs">
      <aside class="rs-left">
        <div class="rs-deckbar">
          <input id="rs-title" class="rs-title" placeholder="Deck title" aria-label="Deck title" />
          <div class="rs-selects">
            <label class="sr-only" for="rs-theme">Theme</label>
            <select id="rs-theme" class="field field--sm">
              <option value="ink">Ink</option>
              <option value="paper">Paper</option>
              <option value="slate">Slate</option>
              <option value="terminal">Terminal</option>
              <option value="blueprint">Blueprint</option>
              <option value="bright">Bright</option>
            </select>
            <label class="sr-only" for="rs-ratio">Ratio</label>
            <select id="rs-ratio" class="field field--sm">
              <option value="16:9">16:9</option>
              <option value="4:3">4:3</option>
            </select>
          </div>
        </div>
        <div class="rs-slides" id="rs-slides"></div>
        <div class="rs-slideactions">
          <button class="btn btn--sm" id="rs-add-slide">Add</button>
          <button class="btn btn--sm" id="rs-duplicate-slide">Duplicate</button>
          <button class="btn btn--sm btn--danger" id="rs-delete-slide">Delete</button>
        </div>
      </aside>

      <main class="rs-main">
        <div class="rs-stage" id="rs-stage">
          <div class="rs-slide" id="rs-canvas"></div>
        </div>
        <p class="rs-counter" id="rs-counter"></p>
        <p class="rs-hint">Arrow keys move between slides. <kbd>F</kbd> presents fullscreen, <kbd>P</kbd> opens the presenter view in a second window, <kbd>Esc</kbd> leaves.</p>
      </main>

      <aside class="rs-right">
        <label class="rs-field"><span>Layout</span>
          <select id="rs-layout" class="field field--sm">
            <option value="title">Title slide</option>
            <option value="standard">Standard</option>
            <option value="centered">Centred</option>
            <option value="statement">Statement</option>
            <option value="two-column">Two columns</option>
          </select>
        </label>

        <div class="rs-blockshead">
          <h2 class="rs-subhead">Blocks</h2>
          <div class="rs-blockactions">
            <button class="btn btn--sm btn--ghost" id="rs-add-block">+ block</button>
            <button class="btn btn--sm btn--ghost" id="rs-add-image">+ image</button>
          </div>
        </div>
        <div class="rs-blocks" id="rs-blocks"></div>
        <input type="file" id="rs-image-file" accept="image/*" hidden />

        <label class="rs-field"><span>Speaker notes</span>
          <textarea id="rs-notes" class="field rs-notes" rows="6" placeholder="Only you see these, in the presenter view."></textarea>
        </label>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { mountRostrum } from '../apps/rostrum/ui';
  const root = document.getElementById('rostrum-root');
  if (root) void mountRostrum(root as HTMLElement);
</script>

<style is:global>
  .rs { display: grid; grid-template-columns: 15rem minmax(0, 1fr) 20rem; gap: 1rem; padding: 1rem calc((100vw - min(1500px, 100vw - 1.75rem)) / 2) 2rem; align-items: start; }
  .rs-deck { max-width: 11rem; }

  .rs-left { display: grid; gap: 0.5rem; }
  .rs-deckbar { display: grid; gap: 0.35rem; }
  .rs-title { border: 1px solid var(--rule); border-radius: var(--radius-sm); background: var(--paper-raised); padding: 0.4rem 0.5rem; font: 700 0.9rem var(--sans); }
  .rs-selects { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem; }

  .rs-slides { display: grid; gap: 0.25rem; max-height: 24rem; overflow-y: auto; }
  .rs-thumb {
    display: grid; grid-template-columns: auto 1fr; gap: 0.4rem; align-items: baseline; cursor: pointer;
    background: var(--paper-raised); border: 1px solid var(--rule); border-radius: var(--radius-sm);
    padding: 0.45rem 0.5rem; text-align: left;
  }
  .rs-thumb[data-current='true'] { border-color: var(--accent); background: var(--accent-soft); }
  .rs-thumb__num { font: 600 0.7rem var(--mono); color: var(--text-faint); }
  .rs-thumb__label { font-size: 0.82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rs-thumb__layout { grid-column: 2; font: 0.64rem var(--mono); color: var(--text-faint); font-style: normal; }
  .rs-slideactions { display: flex; gap: 0.25rem; }

  .rs-main { display: grid; gap: 0.4rem; justify-items: center; }
  .rs-stage {
    width: 100%; aspect-ratio: 16 / 9; display: grid; place-items: center; overflow: hidden;
    background: var(--paper-sunk); border: 1px solid var(--rule); border-radius: var(--radius);
  }
  .rs-slide { transform-origin: center; display: flex; flex-direction: column; padding: 8% 9%; overflow: hidden; }
  .rs-counter { margin: 0; font: 0.78rem var(--mono); color: var(--text-faint); }
  .rs-hint { margin: 0; font-size: 0.76rem; color: var(--text-faint); text-align: center; max-width: 34rem; }
  .rs-hint kbd { font: 0.85em var(--mono); background: var(--paper-sunk); border: 1px solid var(--rule); border-radius: 3px; padding: 0.05em 0.3em; }

  .rs-slide__content { display: flex; flex-direction: column; gap: 0.5em; width: 100%; }
  .rs-slide[data-layout='title'] .rs-slide__content,
  .rs-slide[data-layout='centered'] .rs-slide__content,
  .rs-slide[data-layout='statement'] .rs-slide__content { justify-content: center; text-align: center; height: 100%; }
  .rs-slide[data-layout='two-column'] .rs-slide__content { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5em 2em; align-content: start; }

  .rs-b { margin: 0; }
  .rs-b--title { font-size: 44px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: var(--slide-accent); }
  .rs-b--subtitle { font-size: 26px; opacity: .85; }
  .rs-b--bullet { font-size: 22px; line-height: 1.5; margin-left: 1.2em; }
  .rs-b--text { font-size: 22px; line-height: 1.5; }
  .rs-b--quote { font-size: 26px; font-style: italic; color: var(--slide-accent); border-left: 4px solid var(--slide-accent); padding-left: 0.6em; }
  .rs-b--code { font-family: var(--mono); font-size: 16px; line-height: 1.5; background: rgba(127,127,127,.16); padding: 0.7em 0.9em; border-radius: 6px; white-space: pre-wrap; }
  .rs-b--divider { border: 0; border-top: 2px solid var(--slide-accent); width: 100%; opacity: .6; }
  .rs-b--image { display: grid; place-items: center; }
  .rs-b--image img { max-width: 100%; max-height: 300px; object-fit: contain; }
  .rs-b--image[data-missing] { opacity: .5; font-size: 18px; }

  .rs-right { display: grid; gap: 0.5rem; }
  .rs-field { display: grid; gap: 0.25rem; }
  .rs-field > span { font: 600 0.75rem var(--sans); color: var(--text-soft); }
  .rs-subhead { font: 600 0.7rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--text-faint); margin: 0; }
  .rs-blockshead { display: flex; justify-content: space-between; align-items: center; }
  .rs-blockactions { display: flex; gap: 0.2rem; }
  .rs-blocks { display: grid; gap: 0.3rem; max-height: 22rem; overflow-y: auto; }
  .rs-block { display: grid; grid-template-columns: 5.5rem 1fr auto auto auto; gap: 0.25rem; align-items: start; }
  .rs-block__type { border: 1px solid var(--rule); border-radius: 4px; background: var(--paper-raised); font-size: 0.72rem; padding: 0.25rem 0.15rem; }
  .rs-block__text { border: 1px solid var(--rule); border-radius: 4px; background: var(--paper-raised); font-size: 0.8rem; padding: 0.25rem 0.35rem; resize: vertical; min-width: 0; font-family: var(--sans); }
  .rs-notes { font-size: 0.85rem; resize: vertical; }
  .rs-icon { background: none; border: 0; cursor: pointer; color: var(--text-faint); font-size: 0.8rem; padding: 0.2rem 0.25rem; }
  .rs-icon:hover { color: var(--text); }

  #rostrum-root[data-presenting='true'] .rs-stage {
    position: fixed; inset: 0; z-index: 500; aspect-ratio: auto; border: 0; border-radius: 0; background: #000;
  }
  #rostrum-root[data-presenting='true'] .rs-hint,
  #rostrum-root[data-presenting='true'] .rs-counter { display: none; }

  @media (max-width: 1100px) {
    .rs { grid-template-columns: 1fr; }
    .rs-slides { max-height: 12rem; }
  }
</style>
